{
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "preserve",
    "target": "ES2022",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/**/*"]
}
